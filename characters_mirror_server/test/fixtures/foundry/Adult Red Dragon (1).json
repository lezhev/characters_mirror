alth-hide-eyes-green.webp","effects":[],"folder":null,"sort":1200000,"flags":{"betterRolls5e":{"quickOther":{"context":"","value":true,"altValue":true},"quickDesc":{"value":true,"altValue":true},"quickSave":{"value":true,"altValue":true},"quickProperties":{"value":true,"altValue":true},"quickTemplate":{"value":true,"altValue":true},"quickFlavor":{"value":true,"altValue":true}},"core":{"sourceId":"Item.SzeUOPWK2EqPzSuC"}},"system":{"description":{"value":"<div class=\"rd__b  rd__b--3\">\n<div class=\"rd__spc-inline-post\">\n<ul>\n<li>\n<section class=\"secret\">Вулканические газы формируют облако радиусом<strong> 20 футов</strong> с центром в точке, которую дракон видит в пределах <strong>120 футов</strong> от себя. Эта сфера распространяется за углы, и в её области видимость @Compendium[laaru-dnd5-hw.conditions.vGF4UG8CxzX3tWHg]{слегка затруднена}. Облако существует до значения инициативы <strong>20 </strong>в следующем раунде. Все существа, начинающие свой ход в этом облаке, должны пройти испытание <strong>Выносливости со СЛ 13</strong>, при провале они @Compendium[laaru-dnd5-hw.conditions.Tlc2LbRijKy9nxxb]{отравлены} до конца своего хода. Пока существо отравлено таким образом, оно @Compendium[laaru-dnd5-hw.conditions.3yQzUJzdrHg1OlIL]{выведено из строя}.</section>\n</li>\n</ul>\n<p>Вулканические газы формируют облако радиусом<strong> 20 футов</strong> с центром в точке, которую дракон видит. Эта сфера распространяется за углы, и в её области видимость @Compendium[laaru-dnd5-hw.conditions.vGF4UG8CxzX3tWHg]{слегка затруднена}. Все существа, начинающие свой ход в этом облаке, должны пройти испытание <strong>Выносливости.</strong></p>\n</div>\n</div>","chat":"","unidentified":""},"source":"MM","activation":{"type":"lair","cost":1,"condition":""},"duration":{"value":"","units":""},"target":{"value":20,"width":null,"units":"ft","type":"sphere"},"range":{"value":null,"long":null,"units":""},"uses":{"value":0,"max":"","per":"","recovery":""},"consume":{"type":"","target":
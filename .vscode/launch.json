{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "server",
            "cwd": "characters_mirror_server",
            "request": "launch",
            "type": "dart",
            "args": [
                "--apply-migrations"
            ]
        },
        {
            "name": "flutter",
            "cwd": "characters_mirror_flutter",
            "request": "launch",
            "type": "dart",
            "toolArgs": [
                "--web-hostname=127.0.0.1"
            ]
        },
        {
            "name": "flutter (profile mode)",
            "cwd": "characters_mirror_flutter",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "flutter (release mode)",
            "cwd": "characters_mirror_flutter",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        },
        {
            "name": "Flutter debug local Serverpod",
            "cwd": "characters_mirror_flutter",
            "request": "launch",
            "type": "dart",
            "deviceId": "6TEEUSRGOFZPAMNR",
            "program": "lib/main.dart",
            "flutterMode": "debug",

            "preLaunchTask": "adb reverse Serverpod",
            "postDebugTask": "adb reverse remove Serverpod",
            
            "toolArgs": [
                "--dart-define=CM_SERVER_URL=http://localhost:8083/"
            ]
        },
        {
            "name": "Flutter release local Serverpod",
            "cwd": "characters_mirror_flutter",
            "request": "launch",
            "type": "dart",
            "deviceId": "6TEEUSRGOFZPAMNR",
            "program": "lib/main.dart",
            "flutterMode": "release",

            "preLaunchTask": "adb reverse Serverpod",
            "postDebugTask": "adb reverse remove Serverpod",


            "toolArgs": [
                "--dart-define=CM_SERVER_URL=http://localhost:8083/"
            ]
        }
    ]
}
